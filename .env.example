# Optional override for the contact form POST URL.
# Default (if unset): {Vite BASE_URL}api/contact.php
# On DreamHost production this is typically same-origin, e.g.:
# VITE_FORM_ENDPOINT=/api/contact.php
# or the absolute URL:
# VITE_FORM_ENDPOINT=https://new32dental.com/api/contact.php

VITE_FORM_ENDPOINT=

# Vite public base path (trailing slash optional).
# Unset or "/" → DreamHost staging/production at site root
# VITE_BASE_PATH=/
