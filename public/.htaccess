# new32 production — DreamHost Apache
# SPA fallback + legacy WordPress URL redirects + trailing-slash normalization
# + compression & cache headers for performance + security headers
#
# Nested routes: any future section with child pages (like /about + /about/slug)
# needs an explicit directory-index rewrite below. DirectorySlash Off does not
# generalize automatically — without that rewrite Apache will 301 /section to
# /section/ and, if Indexes were on, serve a listing instead of the page.

Options -Indexes
DirectorySlash Off

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 application/font-woff2
</IfModule>

# Brotli when available (DreamHost / Apache with mod_brotli)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
</IfModule>

# --- Caching + security ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Report-Only on first rollout so GA / Maps can be verified in the console
  # on staging. Switch to Content-Security-Policy (drop -Report-Only) after
  # Home, Our Office, and Contact show zero violations, then promote.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://analytics.google.com https://stats.g.doubleclick.net; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Hashed Vite assets under /assets/ — long-lived immutable
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Self-hosted fonts and static public assets (logo, awards, robots)
  <If "%{REQUEST_URI} =~ m#^/fonts/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # HTML shell must revalidate so SPA updates deploy immediately
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Rewrites ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Legacy consolidations / orphans (match with or without trailing slash) ---
  RewriteRule ^family-services/?$ /our-services [R=301,L]
  RewriteRule ^fees-insurance/?$ /patient-info [R=301,L]
  RewriteRule ^patient-info/bill-pay/?$ /patient-info [R=301,L]
  RewriteRule ^our-office/google-tour/?$ /our-office [R=301,L]
  RewriteRule ^gallery/kids-day/?$ /gallery [R=301,L]
  RewriteRule ^gallery/before-and-after/?$ /gallery [R=301,L]

  # Short prototype paths → live-compatible canonicals
  RewriteRule ^services/?$ /our-services [R=301,L]
  RewriteRule ^contact/?$ /contact-us [R=301,L]

  # External *.html → extensionless canonicals.
  # Match THE_REQUEST so the later internal rewrite to $1.html is not redirected.
  # Exclude 404.html: ErrorDocument and direct hits must keep serving that file.
  RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
  RewriteRule ^(.+)/index\.html$ /$1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # About is a real directory (bios live under about/*.html). The generic
  # trailing-slash rule below skips directories (`!-d`), so this 301 is required.
  RewriteRule ^about/$ /about [R=301,L]

  # Trailing slash → non-slash (canonical) for non-directories
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about → about/index.html (must run before the generic .html-append rule)
  RewriteRule ^about$ about/index.html [L]

  # Prerendered pages: /our-office → our-office.html (must run before 404)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+[^/])$ $1.html [L]

  # Unknown paths → HTTP 404 (ErrorDocument serves the prerendered page)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html
